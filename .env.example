# Copy to .env and fill in. .env is gitignored: never commit it or paste its values into chat.

# Default environment for commands that do not name one.
QA_ENV=devrms

# ------------------------------------------------------------------------------
# One block per developer environment; the name is the part after QA_
# (QA_DEVRMS_BASE_URL -> environment "devrms").
#
#   _USERNAME / _PASSWORD   main login: one person holding many restaurants
#   _TOTP_SECRET            its Google Authenticator seed (see below)
#   _SUPER_ADMIN_*          the environment super admin
#   _PRODUCTION=1           marks a LIVE site: the harness refuses to touch it
#                           (no browser, every check BLOCKED) unless you also run
#                           with QA_ALLOW_PRODUCTION=1. Dev instances leave it unset.
#
# Seeds from Google Authenticator (menu > Transfer accounts > Export accounts,
# photograph the QR with another device), decoded locally:
#   zbarimg export.jpg | npm run totp:decode               # list accounts, seeds hidden
#   zbarimg export.jpg | npm run totp:decode -- --reveal   # print the seeds
# (zbarimg: sudo apt install zbar-tools / brew install zbar)
# ------------------------------------------------------------------------------

# All developer environments: an empty _BASE_URL keeps one inactive until you fill it.

QA_VICTOR_BASE_URL=https://victor.tabdevx.com
QA_VICTOR_USERNAME=
QA_VICTOR_PASSWORD=
QA_VICTOR_TOTP_SECRET=
QA_VICTOR_SUPER_ADMIN_USERNAME=
QA_VICTOR_SUPER_ADMIN_PASSWORD=
QA_VICTOR_SUPER_ADMIN_TOTP_SECRET=

QA_GODSWILL_BASE_URL=https://godswill.tabdevx.com
QA_GODSWILL_USERNAME=
QA_GODSWILL_PASSWORD=
QA_GODSWILL_TOTP_SECRET=
QA_GODSWILL_SUPER_ADMIN_USERNAME=
QA_GODSWILL_SUPER_ADMIN_PASSWORD=
QA_GODSWILL_SUPER_ADMIN_TOTP_SECRET=

