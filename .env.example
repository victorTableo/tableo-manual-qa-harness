# ------------------------------------------------------------------------------
# Watching and screenshots (defaults shown; change freely)
# ------------------------------------------------------------------------------
# 1 = show the browser for every test run, so you can watch it click through
QA_WATCH=0
# Browser window size (layout is judged at this width): WIDTHxHEIGHT
QA_VIEWPORT=1920x1080
# Milliseconds each action is slowed by while watching (0 = full speed)
QA_SLOWMO=400
# 1 = browser bar with the URL visited and the time on every screenshot, 0 = page only
QA_SCREENSHOT_FRAME=1
# Capture the whole scrollable page: failures | always | never
QA_SCREENSHOT_FULL_PAGE=failures
# 0 = no screenshot when a check passes (failures always get one)
QA_SCREENSHOT_ON_PASS=1

# ------------------------------------------------------------------------------
# Optional (defaults shown)
# ------------------------------------------------------------------------------
# QA_PHONE=+35699999999       use only this phone number (else config/test-data.json)
# QA_EMAIL=glory+promo-test@tableo.com   use only this email (must say "test")
# QA_FORCE_LOGIN=0            1 = ignore cached sign-ins
# QA_SESSION_TTL_MINUTES=480  reuse sign-ins and discovered restaurants this long
# QA_SESSION_RECHECK_MINUTES=10  trust a sign-in proven this recently without opening a page (0 = always check)
# QA_SHARED_BROWSER=1         0 = every command starts its own browser
# QA_BROWSER_IDLE_MINUTES=15  the shared browser closes after this long with no command (npm run browser:stop)
# QA_TRACE=0                  1 = keep Playwright traces (contain typed input)
# QA_TIMEOUT_MS=90000  QA_ACTION_TIMEOUT_MS=15000  QA_NAVIGATION_TIMEOUT_MS=30000  QA_EXPECT_TIMEOUT_MS=10000
# QA_LOCALE=en-GB  QA_TIMEZONE=Europe/London
# QA_ALLOW_PRODUCTION=0       1 = deliberately allow an environment marked _PRODUCTION=1 (one run at a time)
